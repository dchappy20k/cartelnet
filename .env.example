# ==============================================================================
# CartelNet — Environment Configuration Template
# ==============================================================================

# Environment mode: development, staging, production
ENVIRONMENT=development
LOG_LEVEL=info

# Backend API Configuration
PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# In production, PostgreSQL is mandatory:
# DATABASE_URL=postgresql://cartelnet:cartelnet_password@localhost:5432/cartelnet
# In development, leave blank or set to sqlite:///./cartelnet_dev.db for local SQLite fallback:
DATABASE_URL=sqlite:///./cartelnet_dev.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
